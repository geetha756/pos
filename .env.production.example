# ==========================================================================
# PRODUCTION environment for the central server.
# Copy to ".env" ON THE SERVER and fill in the real values.
# Replace portal.YOURDOMAIN.com with your actual Cloudflare-managed subdomain.
# ==========================================================================

# Flask
# Generate a strong secret once:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
FLASK_ENV=production

# Database (on the server). Use a dedicated DB user + password in production.
DATABASE_URL=postgresql://sipnsnack_user:STRONG_DB_PASSWORD@localhost:5432/sipnsnack

# Cookies are only sent over HTTPS in production (the tunnel terminates TLS).
SESSION_COOKIE_SECURE=True

# Google OAuth — the redirect URI MUST exactly match what you register in the
# Google Cloud console (https, your real domain, /auth/callback).
GOOGLE_CLIENT_ID=324070713792-0d3og4s66ieatghimgloblrasot6ks2c.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://portal.YOURDOMAIN.com/auth/callback

# Owner accounts (always admin). Comma-separated.
ADMIN_EMAILS=saivamsiborra99@gmail.com

# Android app (TWA) — fill these AFTER you build the APK so the installed app
# opens without a browser URL bar. See deploy/BUILD_ANDROID_APP.md.
# ANDROID_PACKAGE_NAME=com.sipnsnack.portal
# ANDROID_CERT_FINGERPRINTS=AA:BB:CC:...:99
