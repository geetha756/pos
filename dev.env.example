# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/sipnsnack

# Google OAuth Configuration
GOOGLE_CLIENT_ID=992597649559-l6e8rdc3aq5dvcq5gq6iu8klvre9vfd1.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback

# Security Settings (for production)
SESSION_COOKIE_SECURE=False

# BitBerry chat agent — the agent list is fetched dynamically per user, not
# a single hardcoded agent id. BITBERRY_BASE_URL alone is enough; the two
# specific endpoint URLs below are only needed if BitBerry's path layout
# ever diverges from the default /api/... convention.
BITBERRY_BASE_URL=https://test-bitberry.snfifteen.com
# BITBERRY_API_URL=https://test-bitberry.snfifteen.com/api/chat/completions
# BITBERRY_AGENTS_URL=https://test-bitberry.snfifteen.com/api/v1/users/me/agents
