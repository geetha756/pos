# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/sipnsnack

# Google OAuth Configuration
GOOGLE_CLIENT_ID=992597649559-l6e8rdc3aq5dvcq5gq6iu8klvre9vfd1.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback

# Security Settings (for production)
SESSION_COOKIE_SECURE=False

# Electric Idli Machine — separate FastAPI service (PostgreSQL + MQTT + ESP32).
# The POS talks to it server-side only (see eidli_client.py); nothing here
# is ever sent to the browser.
EIDLI_API_BASE_URL=http://192.168.29.143:8000
# Current provisioned development/test machine. Dev-only convenience value —
# production should not rely on a single hardcoded machine long-term; see
# GET /api/v1/machines for a dynamic machine list once the POS needs more
# than one Electric Idli Machine.
EIDLI_MACHINE_ID=89d2edef-88c4-48d3-b91f-d7aab3bd39d8
# The backend requires this on its mutating endpoints (heater on/off,
# restart, settings writes/sync, session start/complete/stop) — sent as an
# X-API-Key header, added server-side by eidli_client.py. GET/read endpoints
# don't require it. Must match the value the FastAPI backend is configured
# with; get it from whoever administers that service.
EIDLI_API_KEY=
